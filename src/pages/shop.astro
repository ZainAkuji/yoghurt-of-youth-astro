---
import Layout from "../layouts/Layout.astro";
import Shop from "../components/Shop.tsx";
import { nextDispatchISO } from "../config/dispatch";
import { PLAIN_PRICE_PENCE, FLAVOURED_PRICE_PENCE } from "../../lib/pricing";

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "L. reuteri Probiotic Yoghurt",
  "image": "https://yoghurtofyouth.co.uk/spctrl.webp",
  "description": "Fresh-fermented live L. reuteri probiotic yoghurt. Lactose-free, with over 100 billion live cultures per bottle. Made in small batches in Blackburn.",
  "brand": {
    "@type": "Brand",
    "name": "Yoghurt of Youth"
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "GBP",
    "offerCount": 4,
    "lowPrice": (PLAIN_PRICE_PENCE / 100).toFixed(2),
    "highPrice": (FLAVOURED_PRICE_PENCE / 100).toFixed(2),
    "availability": "https://schema.org/InStock",
    "url": "https://yoghurtofyouth.co.uk/shop"
  }
};
---

<Layout
  title="Buy L. reuteri Yoghurt Online UK | Yoghurt of Youth"
  description="Order live L. reuteri probiotic yoghurt online, pick your flavours or subscribe weekly. Lactose-free, over 100 billion CFU, chilled next-day UK delivery."
  productSchema={productSchema}
>
  <Shop client:load initialDispatchISO={nextDispatchISO()} />
</Layout>